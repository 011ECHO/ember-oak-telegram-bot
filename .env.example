# --- Ember & Oak bot configuration ---
# Copy this file to ".env" and fill in the real values.

# Token issued by @BotFather when you create the bot.
BOT_TOKEN=123456789:AA...your-token-here

# Telegram numeric ID of the administrator (chat that receives new orders).
# You can learn your own ID by messaging @userinfobot in Telegram.
ADMIN_CHAT_ID=123456789

# Optional: path to the SQLite database file (defaults to ember_oak.db).
# DB_PATH=ember_oak.db

# Optional: Telegram Payments provider token (@BotFather -> your bot -> Payments).
# Leave empty to disable online payment. For a risk-free demo, connect Stripe in
# TEST mode and use the test card 4242 4242 4242 4242.
# PAYMENT_PROVIDER_TOKEN=284685063:TEST:xxxxxxxx
# PAYMENT_CURRENCY=EUR
